# ────────────────────────────────────────────────
# docker compose 环境变量模板
#
# 用法：cp .env.example .env 后填值；.env 已在 .gitignore 中。
# ★ 这里只放变量名与"该填什么"，**绝不提交真实凭据**。
#   HMAC 密钥、模型 Key、HIS 口令一旦进版本库，删文件也清不掉历史记录。
# ────────────────────────────────────────────────

# 对外端口
ASK_PORT=8000

# 数据源：ads（本地宽表，默认）| his（直连镜像库）
ASK_DS=ads

# ── 直连 HIS 时才需要（必须只读账号）──
# ASK_HIS_HOST=10.1.33.46
# ASK_HIS_PORT=1521
# ASK_HIS_SERVICE=ORCL
# ASK_HIS_USER=ask_ro
# ASK_HIS_PASSWORD=
# Oracle 11.2 必须 thick mode，并挂载 Instant Client（见 docker-compose.yml）
# ASK_HIS_THICK=1
# ASK_ORACLE_CLIENT_LIB=/opt/oracle/instantclient_11_2

# ── 鉴权：容器里不能用 demo ──
# ASK_AUTH_MODE 决定「身份从哪来」：sso（CAS/OIDC 票据）或 gateway（网关注入可信头）。
# ASK_AUTH_LOCAL 决定「本地账号这个凭证入口开不开」：off / breakglass / primary。
# ★ 没有 ASK_AUTH_MODE=local 这个取值；也没有 ASK_AUTH_LOCAL=on（写成这样登录页都出不来）。
ASK_AUTH_MODE=sso
ASK_AUTH_LOCAL=primary
# 首次启动（账号表为空）时，客户端首页会出现「创建管理员账号」，不必再进命令行自举。

# ── 模型：必须指向院内私有化服务 ──
ASK_LLM_BASE_URL=
ASK_LLM_MODEL=
ASK_LLM_API_KEY=
ASK_LLM_TIMEOUT=60

# ── 执行层限流（保护 HIS）──
ASK_QUERY_MAX_CONCURRENT=4
ASK_QUERY_PER_MINUTE=120

# ── Few-shot：未跑出 G1 vs G2 增益前保持 0 ──
ASK_FEWSHOT=0
